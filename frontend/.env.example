# ---- Supabase (Supabase Dashboard -> Project Settings -> API) ----
# Copy the "Project URL" and the "anon public" key EXACTLY (the key is long).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Backend API ----
# Local dev: http://localhost:5000  |  Production: your Render URL
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_FALLBACK_URL=
# Optional cap (ms) on the primary attempt when a fallback is set (default 20000)
# NEXT_PUBLIC_API_TIMEOUT_MS=20000

# ---- Landing-page demo widget ----
# Organization whose bot is shown in the bottom-right bubble on the marketing
# page (/). The widget script itself is served by the backend at /widget.js.
NEXT_PUBLIC_DEMO_ORG_ID=your-organization-id

